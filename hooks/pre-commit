#!/usr/bin/env bash
# pre-commit: bloqueia commits com possíveis dados sensíveis.
#
# Regras:
#   • Bloqueia atribuições de password/token/secret/API key e formatos
#     conhecidos (AKIA..., chave privada PEM, "Bearer <token>").
#   • Arquivos de chave/certificado/.env são verificados (pode conter segredo).
#   • Arquivos binários (imagens, fonts, vídeo, áudio, PDF, compactados) são
#     pulados porque pesquisar texto neles não faz sentido.
#
# Uso: basta que o arquivo esteja no .git/hooks/pre-commit (symlink ou cópia).
# Ex: ln -sf ../../hooks/pre-commit .git/hooks/pre-commit   (da raiz do repo)

set -uo pipefail

BLOCKED=0

while IFS= read -r f; do
  [ -n "$f" ] || continue

  # Pula o proprio hook de pre-commit (hooks/pre-commit contem os padroes
  # que ele verifica; sem isso, o commit "auto-bloqueia" ao adicionar este mesmo hook)
  case "$f" in
    hooks/pre-commit) continue ;;
  esac

  # Arquivos de documentação não contêm segredos (são textos explicativos);
  # pulamos para evitar falso-positivo ("tokens", "AKIA" citados como
  # "não commitar", não como dados reais).
  case "$f" in
    docs/*) continue ;;
  esac

  # Arquivos binários não são verificados (evita falso-positivo)
  case "$f" in
    *.png|*.jpg|*.jpeg|*.gif|*.bmp|*.ico|*.woff|*.woff2|*.ttf|*.eot|*.otf|*.mp4|*.webm|*.mp3|*.wav|*.zip|*.tar|*.gz|*.bz2|*.xz|*.pdf|*.xlsx|*.docx|*.pptx|*.sqlite)
      continue
      ;;
  esac

  # Exige contexto de atribuição E um valor com cara de segredo (>= 8 chars),
  # para reduzir falsos positivos como `password = ""` em campos de UI.
  SECRET_RE="(password|passwd|secret|token|api[_-]?key|apikey|access[_-]?key|client[_-]?secret|private[_-]?key)[[:space:]]*[:=][[:space:]]*(\"[^\"]{8,}\"|'[^']{8,}'|[A-Za-z0-9_./+~-]{16,})|authorization[[:space:]]*[:=]|bearer[[:space:]]+[A-Za-z0-9._~+/-]{16,}=*|AKIA[0-9A-Z]{16}|-----BEGIN [A-Z ]*PRIVATE KEY-----"
  if grep -iEn "$SECRET_RE" "$f" >/dev/null 2>&1; then
    echo "================================================================"
    echo "⚠️  Possível dado sensível no arquivo:"
    echo "   $f"
    echo "   Padrões detectados: credencial atribuída, token, chave de API/privada."
    echo "   Remova o dado sensível e tente novamente."
    echo "================================================================"
    BLOCKED=1
  fi
done < <(git diff --cached --name-only --diff-filter=ACM)

if [ "$BLOCKED" -eq 1 ]; then
  echo
  echo "Commit BLOQUEADO. Corrija os arquivos acima e tente novamente."
  exit 1
fi

echo "✅ Nenhum dado sensível detectado. Commit permitido."
exit 0
