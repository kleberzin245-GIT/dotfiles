#!/usr/bin/env bash
# Uso: ./dotsave [-y|--yes] "o que você mudou"
#   Commita (e dá push, se houver remoto). O hook pre-commit é ativado sozinho.
set -euo pipefail

cd "$(dirname "$(readlink -f "$0")")" || exit 1

usage() {
  cat <<'EOF'
Uso: ./dotsave [OPÇÃO] [MENSAGEM]

  MENSAGEM        descrição do commit (padrão: "ajustes no rice")
  -y, --yes       não pede confirmação antes de commitar
  -h, --help      mostra esta ajuda
EOF
}

ASSUME_YES=0
MESSAGE=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    -y|--yes) ASSUME_YES=1 ;;
    -h|--help) usage; exit 0 ;;
    --) shift; MESSAGE="${*:-}"; break ;;
    -*) echo "ERRO: opção desconhecida: $1" >&2; usage >&2; exit 2 ;;
    *) MESSAGE="${MESSAGE:+$MESSAGE }$1" ;;
  esac
  shift
done
MESSAGE="${MESSAGE:-ajustes no rice}"

# Verificar se é um repositório Git
if ! git rev-parse --git-dir >/dev/null 2>&1; then
  echo "ERRO: o diretório atual não é um repositório Git." >&2
  exit 1
fi

# Ativa o hook de proteção contra dados sensíveis (se ainda não estiver ativo)
if [ -f hooks/pre-commit ]; then
  chmod +x hooks/pre-commit
  if [ "$(git config --get core.hooksPath 2>/dev/null || true)" != "hooks" ]; then
    git config core.hooksPath hooks
    echo "hook pre-commit ativado (core.hooksPath=hooks)."
  fi
else
  echo "AVISO: hooks/pre-commit não encontrado; o commit não será verificado." >&2
fi

# Mostrar arquivos modificados antes de adicionar
echo "=== Arquivos a serem commitados ==="
git status --short
echo "=== Diferença detalhada (arquivos já rastreados) ==="
git diff HEAD || true

if [ "$ASSUME_YES" -eq 0 ]; then
  echo "=== Digite 'y' para continuar ou 'n' para abortar ==="
  read -r confirm || true
  case "${confirm:-}" in
    y|Y) ;;
    *) echo "Cancelado."; exit 0 ;;
  esac
fi

# Adicionar arquivos
git add -A

# Evitar commit vazio
if git diff --cached --quiet; then
  echo "Nada novo para commitar."
  exit 0
fi

# Commit
git commit -m "$MESSAGE"

# Push
if git remote get-url origin >/dev/null 2>&1; then
  git push -u origin HEAD
else
  echo "AVISO: nenhum remote 'origin' configurado. Push ignorado." >&2
fi
