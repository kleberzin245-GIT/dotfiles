@import "colors.rasi"

configuration {
    show-icons: true;
}

window {
    transparency: "real";
    location: center;
    anchor: center;
    width: 70%;
    background-color: @surface-a;
    border: 2px;
    border-color: @primary;
    border-radius: 16px;
}

mainbox {
    children: [ inputbar, listview ];
    spacing: 16px;
    padding: 22px;
    background-color: transparent;
}

inputbar {
    children: [ prompt, entry ];
    spacing: 10px;
    padding: 10px 16px;
    background-color: @surface-high;
    border-radius: 12px;
    text-color: @on-surface;
}
prompt { text-color: @primary; background-color: transparent; }
entry  { placeholder: "buscar..."; placeholder-color: @outline; text-color: @on-surface; background-color: transparent; }

/* 2 filas x 4 colunas; a janela se ajusta ao conteúdo (não tem altura fixa) */
listview {
    columns: 4;
    lines: 2;
    fixed-columns: true;
    dynamic: false;
    cycle: false;
    scrollbar: false;
    spacing: 14px;
    background-color: transparent;
}

element {
    orientation: vertical;
    padding: 8px;
    spacing: 8px;
    border-radius: 12px;
    background-color: transparent;
    text-color: @on-surface;
}
element selected.normal {
    background-color: @primary-container;
    text-color: @on-primary-container;
}
element-icon {
    size: 170px;
    horizontal-align: 0.5;
    border-radius: 10px;
    background-color: transparent;
}
element-text {
    horizontal-align: 0.5;
    vertical-align: 0.5;
    text-color: inherit;
    background-color: transparent;
}
