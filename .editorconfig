# Configurações de edição para contribuidores e editores

root = true

# Padrão para todos os arquivos
[*]
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true
indent_style = space
indent_size = 4

# Markdown não remove o espaço final (ele é válido em blocos de código)
[*.md]
trim_trailing_whitespace = false

# Python
[*.py]
indent_style = space
indent_size = 4

# Shell scripts
[*.sh]
indent_style = space
indent_size = 4
end_of_line = lf
